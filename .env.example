# Used by the AWS CDK CLI. Set these before deploy, or rely on your AWS profile.
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=eu-west-1

# Local / pipeline context. These are written into the gitignored cdk.json
# by scripts/ensure-cdk-json.js when the matching env vars are set.
STAGE=dev
FIREBASE_PROJECT_ID=your-actual-firebase-project-id

# Required to deploy the CodePipeline that builds on push to master.
# Create a GitHub connection in AWS Developer Tools, then:
#   npm run deploy:pipeline
GITHUB_OWNER=your-github-user
GITHUB_REPO=wardrobe-backend
GITHUB_BRANCH=master
CODESTAR_CONNECTION_ARN=arn:aws:codeconnections:REGION:ACCOUNT:connection/xxxxxxxx
